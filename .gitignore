# segredos (chaves de API dele — nunca versionar)
.streamlit/secrets.toml

# ambientes
.venv/
__pycache__/
*.pyc
!mlcore/_recovered/*.pyc

# DADOS E MODELO SAO VERSIONADOS (app-online 24/07, mesma decisao do LoL):
# o app roda na Streamlit Community Cloud, que so puxa do git e NAO consegue
# treinar (1GB de RAM). Sem os dados/artefatos no repo a nuvem sobe vazia — foi
# exatamente o que aconteceu com o LoL (painel em N/A por semanas). ~42 MB, cabe
# folgado. Quem atualiza e o robo/PC; a nuvem so carrega (modo viewer).
data.pre_*.csv
raw_matches.jsonl

# estado de maquina / caches / relatorios de runtime
csv_bootstrap_*.json
opendota_sync_state.json
sync_daily.log
ops/
evidence/*
