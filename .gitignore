# Regra de engenharia (2026-07-14): estado de maquina, dados e segredos NAO
# entram em commit — so codigo e configuracao portavel.

# segredos (chaves de API dele — nunca versionar)
.streamlit/secrets.toml

# ambientes
.venv/
__pycache__/
*.pyc
!mlcore/_recovered/*.pyc

# DADOS E MODELO SAO VERSIONADOS (app-online 24/07, mesma decisao do LoL):
# o app roda na Streamlit Community Cloud, que so puxa do git e NAO consegue
# treinar (1GB de RAM). Sem os dados/artefatos no repo a nuvem sobe vazia — foi
# exatamente o que aconteceu com o LoL (painel em N/A por semanas). ~42 MB, cabe
# folgado. Quem atualiza e o robo/PC; a nuvem so carrega (modo viewer).
data.pre_*.csv
raw_matches.jsonl

# estado de maquina / caches / relatorios de runtime
csv_bootstrap_*.json
opendota_sync_state.json
sync_daily.log
ops/
evidence/*
# As NOTAS sao o registro do projeto e o app le algumas delas. Ignorar a
# pasta inteira era heranca do clone — e ja tivemos esse bug uma vez, com
# live_models gitignored: na Streamlit Cloud o arquivo simplesmente nao
# existia. Logs e _tmp_tests continuam de fora.
!evidence/dota_scorecard.json
!evidence/dota_totals_scorecard.json
!evidence/nota_por_liga.json
# O livro-caixa PRECISA ser versionado: e nele que mora o carimbo de
# 'visto pela primeira vez'. Ignorado, a idade zera a cada rodada e o
# ledger nunca envelhece — que e a funcao inteira dele.
!evidence/livro_caixa.json
!evidence/gate_calibradores_dota.json
.gabinete_settings.json
# user_team_aliases.json NAO e estado de maquina: e dado que ELE digita
# (os nomes da casa de apostas, tipo '1win' -> 'Iron Wing') e que o APP LE.
# Ignorado, o que ele digita no PC nunca chega na Streamlit Cloud e o
# recurso fica morto la, calado. Mesmo bug do live_models (07/2026) e do
# evidence/totals_scorecard (26/08/2026). Achado pelo tools/livro_caixa.py.
!user_team_aliases.json
user_schedule_store.json

# As DECLARACOES da regua das 28 sao ENTRADA, nao saida: e o que o repo afirma
# sobre si mesmo. Sem versionar, a esteira roda com zero declaracoes e a nota
# despenca sozinha na nuvem sem nada ter mudado.
!evidence/regua_28_declaracoes.json
